{
  "expo": {
    "name": "Flowboard",
    "slug": "flowboard",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/flowboard-icon.png",
    "scheme": "flowboard",
    "ios": {
      "icon": "./assets/images/flowboard-icon.png",
      "bundleIdentifier": "dev.llferreira.flowboard",
      "supportsTablet": true,
      "appleTeamId": "H32S5S3N46"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#DDF4E9",
        "foregroundImage": "./assets/images/flowboard-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.llferreira.flowboard"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/flowboard-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCFBF8",
          "image": "./assets/images/flowboard-icon.png",
          "imageWidth": 148
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Offline-first mobile Kanban built with Expo and WatermelonDB"
  }
}
